XAI_API_KEY=
GROK_MODEL=
MOCK_LLM=false
PORT=3000
JOIN_URL=
ADMIN_KEY=
# Optional. Weather uses Open-Meteo (free, no key); set this to try OpenWeatherMap first.
OPENWEATHER_API_KEY=
# Optional. TfL Journey Planner works without a key; a free key raises the rate limit.
TFL_APP_KEY=
# Background weather/travel jobs: start when a plan is detected, refresh on a timer,
# and notify phones + the WhatsApp group when something changes. Also switchable in /admin.
WEATHER_ENABLED=true
TRAVEL_ENABLED=true
WEATHER_REFRESH_MS=600000
TRAVEL_REFRESH_MS=900000
# Plan ideas: when this many different people talk about one topic (in the last
# SUGGEST_WINDOW messages) and there's no plan yet, the bot offers 3 options.
SUGGEST_QUORUM=3
SUGGEST_WINDOW=20
# Votes on one option that make it the plan.
SUGGEST_VOTES=3
# Area used for suggestions when the chat names nowhere we know.
DEFAULT_AREA=Shoreditch
# Optional. TheSportsDB key for fixtures; their free public key is used if empty.
SPORTSDB_KEY=
